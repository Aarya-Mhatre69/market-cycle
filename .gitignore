# Secrets
.env
.env.*

# Python
.venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# Locks (uv.lock is intentionally committed for reproducible builds)
# uv.lock  <- do NOT ignore this

# Node
frontend/node_modules/
frontend/.next/
*models/
# Data — large raw datasets, never commit
data/*
# Exception: the Universe Cycle dashboard view reads this file directly and needs
# it present on a fresh clone (e.g. a deploy target) — it's a small classification
# snapshot (~2,200 rows), not a raw dataset, so committing it is fine. (Git can't
# negate a path inside an already-excluded directory — data/* + per-level
# re-inclusion is the standard workaround for data/'s trailing-slash form.)
# hysteresis_state.json is committed alongside it so the daily CI rebuild
# (.github/workflows/rebuild-universe-data.yml) carries dwell-time state forward
# between runs instead of resetting min_dwell counters from scratch every day.
!data/universe_cycle/
data/universe_cycle/*
!data/universe_cycle/latest.csv
!data/universe_cycle/hysteresis_state.json

# Trained model artifacts — committed so Docker build includes them
# models/ is intentionally NOT ignored here

# Misc build / IDE artefacts
.agents/
*.log
.DS_Store

# n8n
n8n/

*temp/
*.egg-info/